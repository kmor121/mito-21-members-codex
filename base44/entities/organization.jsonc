{
  "name": "Organization",
  "type": "object",
  "properties": {
    "fiscal_year_id": {
      "type": "string",
      "description": "FiscalYear record id"
    },
    "org_name": {
      "type": "string",
      "description": "Organization name"
    },
    "org_type": {
      "type": "string",
      "enum": ["幹事会", "委員会", "部会", "室", "その他"],
      "description": "Organization type"
    },
    "parent_id": {
      "type": "string",
      "description": "Parent organization id"
    },
    "sort_order": {
      "type": "number",
      "description": "Display order"
    },
    "supervisor_id": {
      "type": "string",
      "description": "Supervisor member id (e.g. vice president overseeing this org)"
    }
  },
  "required": ["fiscal_year_id", "org_name"],
  "rls": {
    "create": { "$or": [{ "user_condition": { "role": "admin" } }, { "user_condition": { "data.app_role": "admin_member" } }] },
    "read": true,
    "update": { "$or": [{ "user_condition": { "role": "admin" } }, { "user_condition": { "data.app_role": "admin_member" } }] },
    "delete": { "$or": [{ "user_condition": { "role": "admin" } }, { "user_condition": { "data.app_role": "admin_member" } }] }
  }
}
