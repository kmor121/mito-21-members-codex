{
  "name": "OrgAssignment",
  "type": "object",
  "properties": {
    "fiscal_year_id": {
      "type": "string",
      "description": "FiscalYear record id"
    },
    "organization_id": {
      "type": "string",
      "description": "Organization record id"
    },
    "member_id": {
      "type": "string",
      "description": "Member record id"
    },
    "role": {
      "type": "string",
      "description": "Role name in the organization"
    },
    "sort_order": {
      "type": "number",
      "description": "Display order"
    }
  },
  "required": ["fiscal_year_id", "organization_id", "member_id", "role"],
  "rls": {
    "create": { "$or": [{ "user_condition": { "role": "admin" } }, { "user_condition": { "data.app_role": "admin_member" } }] },
    "read": true,
    "update": { "$or": [{ "user_condition": { "role": "admin" } }, { "user_condition": { "data.app_role": "admin_member" } }] },
    "delete": { "$or": [{ "user_condition": { "role": "admin" } }, { "user_condition": { "data.app_role": "admin_member" } }] }
  }
}
