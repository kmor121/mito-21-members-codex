{
  "name": "Newsletter",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Newsletter title"
    },
    "body": {
      "type": "string",
      "description": "Newsletter body"
    },
    "body_html": {
      "type": "string",
      "description": "Newsletter body in HTML format"
    },
    "channel": {
      "type": "string",
      "enum": ["email", "line", "email+line"],
      "description": "Delivery channel",
      "default": "email"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "scheduled", "sent", "cancelled", "failed"],
      "description": "Delivery status",
      "default": "draft"
    },
    "audience_type": {
      "type": "string",
      "enum": ["all", "member_type", "status", "approval_status", "individual"],
      "description": "Audience selector type",
      "default": "all"
    },
    "audience_filter_json": {
      "type": "string",
      "description": "Serialized audience filter payload"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time",
      "description": "Scheduled send datetime"
    },
    "last_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last sent datetime"
    },
    "error_message": {
      "type": "string",
      "description": "Last delivery error message"
    },
    "attachment_info": {
      "type": "string",
      "description": "Attachment placeholder text"
    },
    "attachments_json": {
      "type": "string",
      "description": "Serialized attachment metadata list"
    },
    "is_template": {
      "type": "boolean",
      "description": "Whether this record is a template",
      "default": false
    },
    "sent_count": {
      "type": "number",
      "description": "Number of recipients the newsletter was actually sent to",
      "default": 0
    }
  },
  "required": ["title", "channel", "status", "audience_type"],
  "rls": {
    "create": { "$or": [{ "user_condition": { "role": "admin" } }, { "user_condition": { "data.app_role": "admin_member" } }] },
    "read": { "$or": [{ "user_condition": { "role": "admin" } }, { "user_condition": { "data.app_role": "admin_member" } }] },
    "update": { "$or": [{ "user_condition": { "role": "admin" } }, { "user_condition": { "data.app_role": "admin_member" } }] },
    "delete": { "$or": [{ "user_condition": { "role": "admin" } }, { "user_condition": { "data.app_role": "admin_member" } }] }
  }
}
