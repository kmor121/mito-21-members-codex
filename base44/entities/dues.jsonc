{
  "name": "Due",
  "type": "object",
  "properties": {
    "fiscal_year_id": {
      "type": "string",
      "description": "FiscalYear record id"
    },
    "member_id": {
      "type": "string",
      "description": "Member record id"
    },
    "amount": {
      "type": "number",
      "description": "Due amount for the fiscal year"
    },
    "status": {
      "type": "string",
      "enum": ["未納", "納入済"],
      "description": "Payment status"
    },
    "due_type": {
      "type": "string",
      "enum": ["年会費", "入会金", "後期入会会費"],
      "description": "Type of due: annual fee, admission fee, or half-year fee",
      "default": "年会費"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "description": "Paid date"
    },
    "notes": {
      "type": "string",
      "description": "Admin notes"
    },
    "payer_name": {
      "type": "string",
      "description": "Name used for bank transfer (振込名義)"
    }
  },
  "required": ["fiscal_year_id", "member_id", "amount", "status"],
  "rls": {
    "create": { "$or": [{ "user_condition": { "role": "admin" } }, { "user_condition": { "data.app_role": "admin_member" } }] },
    "read": true,
    "update": { "$or": [{ "user_condition": { "role": "admin" } }, { "user_condition": { "data.app_role": "admin_member" } }] },
    "delete": { "$or": [{ "user_condition": { "role": "admin" } }, { "user_condition": { "data.app_role": "admin_member" } }] }
  }
}
